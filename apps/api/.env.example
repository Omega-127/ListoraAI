# --- Database ---
DATABASE_URL=postgresql://bizlisting:bizlisting_dev@localhost:5432/bizlisting

# --- AI ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- Owner login (single owner for the prototype) ---
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
OWNER_EMAIL=owner@example.com
# Generate with: node -e "const b=require('bcryptjs');b.hash('yourpassword',10).then(console.log)"
OWNER_PASSWORD_HASH=your-bcrypt-hash-here

# --- CORS: comma-separated frontend origins ---
CORS_ORIGINS=http://localhost:5173

# --- Mock listing platforms (comma-separated base URLs) ---
MOCK_PLATFORM_URLS=http://localhost:4100

NODE_ENV=development
PORT=4000
