// Prisma schema for Business Listing Consistency Agent
// See ARCHITECTURE.md §4.6 for full model descriptions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Core models
// ---------------------------------------------------------------------------

model BusinessProfile {
  id           String   @id @default(uuid())
  name         String
  address      String
  phone        String   // stored as E.164
  regularHours Json
  holidayHours Json
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model Listing {
  id         String     @id @default(uuid())
  platform   String
  externalId String
  values     Json
  fetchedAt  DateTime
  createdAt  DateTime   @default(now())

  mismatches Mismatch[]

  @@unique([platform, externalId])
}

model Mismatch {
  id           String       @id @default(uuid())
  listingId    String
  listing      Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  field        String
  profileValue Json
  listingValue Json?
  kind         MismatchKind
  explanation  String?
  resolved     Boolean      @default(false)
  createdAt    DateTime     @default(now())

  proposals Proposal[]

  @@index([listingId])
  @@index([kind])
  @@index([resolved])
}

model Proposal {
  id         String         @id @default(uuid())
  mismatchId String
  mismatch   Mismatch       @relation(fields: [mismatchId], references: [id], onDelete: Cascade)
  platform   String
  field      String
  oldValue   Json?
  newValue   Json
  status     ProposalStatus @default(PENDING_APPROVAL)
  approvedAt DateTime?
  approvedBy String?
  rejectedAt DateTime?
  createdAt  DateTime       @default(now())

  updateResults UpdateResult[]
  verifications Verification[]

  @@index([status])
  @@index([mismatchId])
}

model UpdateResult {
  id         String        @id @default(uuid())
  proposalId String
  proposal   Proposal      @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  outcome    UpdateOutcome
  response   Json?
  createdAt  DateTime      @default(now())

  @@index([proposalId])
  @@index([outcome])
}

model Verification {
  id            String             @id @default(uuid())
  proposalId    String
  proposal      Proposal           @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  observedValue Json?
  status        VerificationStatus @default(PENDING)
  checkedAt     DateTime           @default(now())

  @@index([proposalId])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(uuid())
  eventType String
  actor     String   // "owner" | "agent" | "system"
  payload   Json
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([eventType])
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum MismatchKind {
  MISSING
  OUTDATED
  CONFLICTING
  NEEDS_REVIEW
  OK
}

enum ProposalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum UpdateOutcome {
  SUCCESS
  FAILED
  BLOCKED
}

enum VerificationStatus {
  VERIFIED
  PENDING
  FAILED
  BLOCKED
}
